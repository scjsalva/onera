#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# Prepare the database on boot so a fresh deploy comes up ready. db:prepare
# creates and migrates when needed and is a no-op afterwards, and the seeds
# only load reference data (currencies, categories, rates) - demo data is
# skipped unless SEED_DEMO_DATA is set.
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
  ./bin/rails db:seed
fi

exec "${@}"
