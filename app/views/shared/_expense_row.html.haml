- share = expense.base_share_for(current_user.id)
- involved = expense.expense_splits.any? { |split| split.user_id == current_user.id }

= link_to expense_path(expense), class: "press flex items-center gap-3 bg-white px-4 py-3 transition hover:bg-ink-50", data: { reveal: true } do
  %span.grid.h-10.w-10.shrink-0.place-items-center.rounded-xl.text-sm.font-semibold{ class: expense.voided? ? "bg-ink-100 text-ink-400" : "bg-brand-50 text-brand-700" }
    = expense.spent_on.strftime("%-d")
    %span.sr-only= expense.spent_on.strftime("%B")

  %span.min-w-0.flex-1
    %span.flex.items-center{ class: "gap-1.5" }
      %span.truncate.font-medium{ class: expense.voided? ? "text-ink-400 line-through" : "text-ink-900" }= expense.description
      - if expense.voided?
        %span.pill.bg-ink-200.text-ink-600 Voided
      - if expense.personal?
        %span.pill.bg-ink-100.text-ink-500 Just you
    %span.flex.items-center.text-xs.text-ink-500{ class: "mt-0.5 gap-1.5" }
      - if expense.group
        %span.truncate= expense.group.name
        %span ·
      %span.truncate= expense.paid_by_label
      - if expense.indicative_rate?
        %span ·
        %span.text-sand-600{ title: "Converted at an estimated rate until you settle up" } est. rate

  %span.shrink-0.text-right
    %span.block.font-semibold.tnum{ class: expense.voided? ? "text-ink-400" : "text-ink-900" }= expense.amount.format
    - if involved && !expense.personal?
      %span.block.text-xs.text-ink-500 your share #{share.format}
