.flex.items-center.gap-3.bg-white.px-4.py-3{ data: { reveal: true } }
  %span.grid.h-10.w-10.shrink-0.place-items-center.rounded-xl{ class: settlement.voided? ? "bg-ink-100 text-ink-400" : "bg-positive-50 text-positive-600" }
    %svg.h-5.w-5{ fill: "none", stroke: "currentColor", "stroke-width" => "2", viewBox: "0 0 24 24" }
      %path{ "stroke-linecap" => "round", "stroke-linejoin" => "round", d: "M8 7h12m0 0l-3-3m3 3l-3 3M16 17H4m0 0l3 3m-3-3l3-3" }

  %span.min-w-0.flex-1
    %span.flex.items-center{ class: "gap-1.5" }
      %span.truncate.font-medium{ class: settlement.voided? ? "text-ink-400 line-through" : "text-ink-900" }= settlement.summary
      - if settlement.voided?
        %span.pill.bg-ink-200.text-ink-600 Voided
    %span.block.truncate.text-xs.text-ink-500{ class: "mt-0.5" }
      = relative_day(settlement.settled_on)
      - if defined?(show_group) && show_group && settlement.group
        = "· #{settlement.group.name}"
      - if settlement.payment_method.present?
        = "· #{settlement.payment_method}"

  %span.shrink-0.font-semibold.tnum{ class: settlement.voided? ? "text-ink-400" : "text-ink-900" }= settlement.amount.format
