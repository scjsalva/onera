-# Everything that makes this installable, shared by both layouts. It lived
-# only in the signed-in one, so the sign-in page - the only page somebody who
-# has not joined yet ever sees - was not installable at all.
%meta{ name: "theme-color", content: "#f1f3f5" }
%link{ rel: "icon", href: "/icon.svg", type: "image/svg+xml" }
%link{ rel: "icon", href: "/icon.png", type: "image/png", sizes: "512x512" }
%link{ rel: "apple-touch-icon", href: "/apple-touch-icon.png" }
%link{ rel: "mask-icon", href: "/icon-mask.svg", color: "#2b62f0" }
%link{ rel: "manifest", href: "/manifest.json" }
%meta{ name: "apple-mobile-web-app-capable", content: "yes" }
%meta{ name: "mobile-web-app-capable", content: "yes" }
%meta{ name: "apple-mobile-web-app-title", content: "Onera" }
%meta{ name: "apple-mobile-web-app-status-bar-style", content: "default" }
