- show_group = defined?(show_group) && show_group
- mine = settlement_involves?(settlement, current_user)

.flex.items-center.gap-3.px-4{ class: "bg-positive-50/60 py-2.5", data: { reveal: true } }
  %span.grid.h-7.w-7.shrink-0.place-items-center.rounded-full{ class: settlement.voided? ? "bg-ink-200 text-ink-400" : "bg-positive-100 text-positive-700" }
    %svg.icon-sm{ fill: "none", stroke: "currentColor", "stroke-width" => "2.2", viewBox: "0 0 24 24" }
      %path{ "stroke-linecap" => "round", "stroke-linejoin" => "round", d: "M8 7h12m0 0l-3-3m3 3l-3 3M16 17H4m0 0l3 3m-3-3l3-3" }

  %span.min-w-0.flex-1
    %span.flex.items-center.gap-2
      %span.truncate.text-sm.font-medium{ class: settlement.voided? ? "text-ink-400 line-through" : (mine ? "text-positive-900" : "text-ink-600") }
        = settlement_label(settlement, current_user)
      - if settlement.voided?
        %span.pill.bg-ink-200.text-ink-600 Voided
    %span.block.truncate.text-xs.text-ink-500
      = "settled up · #{relative_day(settlement.settled_on)}"
      - if show_group && settlement.group
        = "· #{settlement.group.name}"
      - elsif settlement.group.nil?
        = "· direct"

  %span.shrink-0.text-sm.font-semibold.tnum{ class: settlement.voided? ? "text-ink-400" : "text-positive-700" }
    = settlement.amount.format
