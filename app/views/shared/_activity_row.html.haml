%li.flex.gap-3.px-4.py-3{ data: { reveal: true } }
  - if event.actor
    = avatar_tag(event.actor, size: :sm)
  - else
    %span.grid.h-8.w-8.place-items-center.rounded-full.bg-ink-200.text-ink-500
      %svg.h-4.w-4{ fill: "none", stroke: "currentColor", "stroke-width" => "2", viewBox: "0 0 24 24" }
        %circle{ cx: "12", cy: "12", r: "9" }
  %span.min-w-0.flex-1
    %span.block.text-sm.text-ink-800= event.summary
    %span.block.text-xs.text-ink-400{ class: "mt-0.5" }
      = time_ago_in_words(event.occurred_at)
      = "ago"
      - if defined?(show_group) && show_group && event.group
        = "· #{event.group.name}"
