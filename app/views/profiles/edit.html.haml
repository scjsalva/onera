- page_title "Edit profile"
- content_for :heading, "Edit profile"
- content_for :back_path, profile_path

= form_with model: current_user, url: profile_path, method: :patch, class: "space-y-5" do |form|
  .card.card-pad.space-y-4{ data: { reveal: true } }
    %div
      = form.label :name, class: "label"
      = form.text_field :name, class: "input"
    %div
      = form.label :email, "Email (optional)", class: "label"
      = form.email_field :email, class: "input", placeholder: "you@example.com"
    %div
      = form.label :date_of_birth, "Birthday (optional)", class: "label"
      = form.date_field :date_of_birth, class: "input"
    %div
      = form.label :preferred_currency_code, "Your currency", class: "label"
      = form.select :preferred_currency_code, currency_options, {}, class: "input"
      %p.mt-1.text-xs.text-ink-500
        Used for your own totals and for personal expenses. Groups keep their own currency.

  = form.submit "Save", class: "btn-primary w-full"

.mt-6.card.card-pad{ data: { reveal: true } }
  %p.label Appearance
  %theme-toggle


.mt-8{ data: { reveal: true } }
  %delete-profile-button{ "action" => profile_path,
                          "name" => current_user.name,
                          "archived-label" => next_archived_label,
                          "group-count" => current_user.groups.active.count,
                          "expense-count" => current_user.shared_expenses.active.count }
