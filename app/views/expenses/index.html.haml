- page_title "Expenses"
- content_for :heading, "Expenses"

= render "shared/filter_bar", filter: @filter, scope: :global

- if @timeline.any?
  = render "shared/timeline", timeline: @timeline, show_group: true
- elsif @filter.any?
  = render "shared/empty_state", title: "Nothing to show", body: "No expenses match these filters.",
                                 action: link_to("Clear filters", expenses_path, class: "btn-secondary btn-sm")
- else
  = render "shared/empty_state", title: "No expenses yet",
                                 body: "Add one and it lands here, with everything you're part of."
