- page_title "Who are you?"

.relative.flex.min-h-dvh.flex-col.justify-between.overflow-hidden.px-6.pb-10.pt-16
  -# Ambient wash. Static markup, so it costs nothing.
  .pointer-events-none.absolute.-left-24.-top-24.h-72.w-72.rounded-full.opacity-50.blur-3xl{ class: "bg-brand-solid" }
  .pointer-events-none.absolute.-bottom-32.-right-20.h-80.w-80.rounded-full.opacity-30.blur-3xl{ class: "bg-brand-500" }

  .relative
    %span.grid.h-12.w-12.place-items-center.rounded-2xl.backdrop-blur.animate-pop{ class: "bg-white/10" }
      %svg.h-6.w-6.text-white{ viewBox: "0 0 24 24", fill: "none" }
        %circle{ cx: "9", cy: "12", r: "6", stroke: "currentColor", "stroke-width" => "2.4" }
        %path{ d: "M15 6a6 6 0 010 12", stroke: "currentColor", "stroke-width" => "2.4", "stroke-linecap" => "round", opacity: "0.55" }
    %h1.mt-6.text-3xl.font-bold.tracking-tight.text-white Onera
    %p.mt-2.max-w-xs{ class: "text-white/70" } Shared costs, settled without the spreadsheet.

  .relative.mt-10
    %p.mb-3.text-sm.font-medium{ class: "text-white/70" } Who's using the app?

    = form_with url: user_selection_path, method: :post, class: "space-y-2" do |form|
      - @users.each_with_index do |user, index|
        %button.group.flex.w-full.items-center.gap-3.rounded-2xl.p-3.text-left.backdrop-blur.transition{ type: "submit", name: "user_id", value: user.id, class: "hover:bg-white/20 active:scale-[0.98] bg-white/10", data: { reveal: true }, style: "--reveal-delay: #{index * 60}ms" }
          = avatar_tag(user, size: :md)
          %span.min-w-0.flex-1
            %span.block.truncate.font-semibold.text-white= user.name
            - if user.email.present?
              %span.block.truncate.text-sm{ class: "text-white/70" }= user.email
          %svg.h-5.w-5.transition-transform{ class: "text-white/50 group-hover:translate-x-0.5", fill: "none", stroke: "currentColor", "stroke-width" => "2", viewBox: "0 0 24 24" }
            %path{ "stroke-linecap" => "round", "stroke-linejoin" => "round", d: "M9 5l7 7-7 7" }

    - if @users.empty?
      .rounded-2xl.p-6.text-center.backdrop-blur{ class: "bg-white/10" }
        %p.text-white Nobody exists yet.
        = link_to "Create the first person", new_person_path, class: "btn-primary mt-3"

  .relative.mt-8.space-y-3
    = link_to new_person_path, class: "flex items-center justify-center gap-2 text-sm font-medium text-white/70 transition hover:text-white" do
      %svg.h-4.w-4{ fill: "none", stroke: "currentColor", "stroke-width" => "2", viewBox: "0 0 24 24" }
        %path{ "stroke-linecap" => "round", d: "M12 5v14M5 12h14" }
      Add someone new
    %p.text-center.text-xs{ class: "text-white/45" }
      No password needed yet — pick a name to carry on.
