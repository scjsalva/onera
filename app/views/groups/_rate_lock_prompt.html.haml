.rounded-card.border.border-sand-200.bg-sand-50.p-4{ data: { reveal: true } }
  .flex.items-start.gap-3
    %span.grid.h-9.w-9.shrink-0.place-items-center.rounded-xl.bg-sand-100.text-sand-600
      %svg.h-5.w-5{ fill: "none", stroke: "currentColor", "stroke-width" => "2", viewBox: "0 0 24 24" }
        %path{ "stroke-linecap" => "round", "stroke-linejoin" => "round", d: "M8 7h12m0 0l-3-3m3 3l-3 3M16 17H4m0 0l3 3m-3-3l3-3" }
    .min-w-0.flex-1
      %p.font-semibold.text-ink-900
        = pluralize(pending.sum(&:expense_count), "expense")
        in #{pending.map { |p| p.currency.code }.to_sentence}
      %p.mt-1.text-sm.text-ink-600
        Still shown at an estimated rate. Settle up to choose the rate that counts.
      = link_to "Settle up", group_settle_up_path(group), class: "btn-primary btn-sm mt-3"
