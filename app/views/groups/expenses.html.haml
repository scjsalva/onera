- page_title "#{@group.name} expenses"
- content_for :heading, @group.name
- content_for :back_path, group_path(@group)

= render "groups/tabs", group: @group

- if @group.archived?
  .mb-4= render "groups/archived_banner", group: @group
= render "shared/filter_bar", filter: @filter, scope: :group, group: @group

- if @timeline.any?
  = render "shared/timeline", timeline: @timeline
- elsif @filter.any?
  = render "shared/empty_state", title: "Nothing here", body: "No expenses match these filters.",
                                 action: link_to("Clear filters", expenses_for_group_path(@group), class: "btn-secondary btn-sm")
- else
  = render "shared/empty_state", title: "Nothing in #{@group.name} yet",
                                 body: "The first expense anyone adds shows up here."
