!!!
%html{ lang: "en", class: "h-full" }
  %head
    %meta{ charset: "utf-8" }
    %meta{ name: "viewport", content: "width=device-width, initial-scale=1, viewport-fit=cover" }
    %meta{ name: "theme-color", content: "#f1f3f5" }
    %link{ rel: "icon", href: "/icon.svg", type: "image/svg+xml" }
    %link{ rel: "icon", href: "/icon.png", type: "image/png", sizes: "512x512" }
    %link{ rel: "apple-touch-icon", href: "/apple-touch-icon.png" }
    %link{ rel: "mask-icon", href: "/icon-mask.svg", color: "#2b62f0" }
    %title= [ yield(:title).presence, "Onera" ].compact.join(" · ")
    :javascript
      (function () {
        try {
          var pref = localStorage.getItem('onera:theme');
          var dark = pref === 'dark' ||
                     ((!pref || pref === 'system') && matchMedia('(prefers-color-scheme: dark)').matches);
          if (dark) document.documentElement.classList.add('dark');
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta && dark) meta.content = '#101216';
        } catch (e) {}
      })();
    %meta{ name: "turbo-cache-control", content: "no-preview" }
    -# Lets Turbo cross-fade between pages instead of replacing them abruptly.
    %meta{ name: "view-transition", content: "same-origin" }
    = csrf_meta_tags
    = csp_meta_tag
    = vite_client_tag
    = vite_stylesheet_tag "~/stylesheets/tailwind.css"
    = vite_javascript_tag "application"
  %body.h-full{ class: "bg-[#0b1020]" }
    #toast-stack.pointer-events-none.fixed.inset-x-0.top-3.flex.flex-col.items-center.gap-2.px-4{ class: "z-[60] md:top-5" }
    #vue.min-h-full{ "v-cloak" => true }
      = yield
