!!!
%html{ lang: "en", class: "h-full" }
  %head
    %meta{ charset: "utf-8" }
    %meta{ name: "viewport", content: "width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1" }
    = render "shared/app_head"
    %title= [ yield(:title).presence, "Onera" ].compact.join(" · ")
    :javascript
      (function () {
        try {
          var pref = localStorage.getItem('onera:theme');
          var dark = pref === 'dark' ||
                     ((!pref || pref === 'system') && matchMedia('(prefers-color-scheme: dark)').matches);
          if (dark) document.documentElement.classList.add('dark');
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta && dark) meta.content = '#101216';
        } catch (e) {}
      })();
    -# Deliberately no "no-preview": Turbo paints the last known state of a page
    -# it has seen before, immediately, while the fresh one is on its way. That
    -# is the difference between a bottom-nav tap feeling instant and feeling
    -# like a website. [data-turbo-preview] styling makes it read as provisional
    -# so nobody mistakes a cached balance for a current one.
    -# Lets Turbo cross-fade between pages instead of replacing them abruptly.
    %meta{ name: "view-transition", content: "same-origin" }
    = csrf_meta_tags
    = csp_meta_tag
    = vite_client_tag
    = vite_stylesheet_tag "~/stylesheets/tailwind.css"
    = vite_javascript_tag "application"
  %body.h-full.overflow-x-hidden{ data: { user_id: current_user&.id } }
    #toast-stack.pointer-events-none.fixed.inset-x-0.top-3.flex.flex-col.items-center.gap-2.px-4{ class: "z-[60] md:top-5" }
    #vue.min-h-full{ "v-cloak" => true }
      = render "shared/top_bar"

      %main.mx-auto.w-full.max-w-5xl.px-4.pt-3{ class: "#{signed_in? ? 'pb-28 md:pl-64' : 'pb-10'} md:pb-10 md:pt-6" }
        = render "shared/flash"
        = yield

      - if signed_in?
        = render "shared/bottom_nav"
        = render "shared/account_sheet"
        %confirm-dialog
        %install-prompt
