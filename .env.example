# Local development needs none of these - config/database.yml points at
# onera_development on your machine. These are what a deployed instance wants.

# Postgres connection string. A free Neon or Supabase database works and
# persists indefinitely; include ?sslmode=require.
DATABASE_URL=postgres://user:password@host/onera?sslmode=require

# Generate with: bin/rails secret
SECRET_KEY_BASE=

# The hostname the app is served on, e.g. onera.onrender.com
APP_HOST=

# Set to any value to load the demo groups on first boot.
SEED_DEMO_DATA=
