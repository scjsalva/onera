# Caddy gets a real certificate from Let's Encrypt on first boot and renews it
# on its own. APP_HOST is the name the certificate is issued for, so it has to
# resolve to this machine before the container starts.
{
	email {$ACME_EMAIL}
}

{$APP_HOST} {
	encode zstd gzip

	# Rails is told the request arrived over TLS, which is what force_ssl and
	# the secure session cookie both key off.
	reverse_proxy web:80 {
		header_up X-Forwarded-Proto https
	}
}
